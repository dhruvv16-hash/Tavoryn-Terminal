{
  "name": "tavoryn-terminal",
  "version": "1.0.0",
  "description": "Tavoryn Terminal — professional-grade local financial workspace and quantitative research platform: function codes, four panels, world markets, news, filings, rates, options, paper execution, and a backtester with quant checks.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js --open",
    "serve": "node server.js",
    "test": "node scripts/test.js",
    "test:live": "node --test test/live.test.js",
    "doctor": "node scripts/doctor.js",
    "compare": "node scripts/compare.js",
    "smoke": "node scripts/smoke.js",
    "check": "node scripts/check.js",
    "launch": "node scripts/launch.js",
    "stop": "node scripts/stop.js",
    "setup": "node scripts/setup.js",
    "desktop:prepare": "node desktop-runtime/scripts/prepare-runtime.js",
    "desktop:dev": "node desktop-runtime/scripts/dev.js",
    "desktop:build": "node desktop-runtime/scripts/build.js",
    "desktop:test": "node desktop-runtime/scripts/test-desktop.js"
  },
  "license": "MIT"
}
